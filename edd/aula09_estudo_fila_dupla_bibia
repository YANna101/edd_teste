from aula09_fila import Fila


class biblia:
    def __init__(self):
        self.fila = Fila()

    def adicionar_versiculo(self, versiculo):
        self.fila.enfileirar(versiculo)

    def remover_versiculo(self):
        return self.fila.desenfileirar()

    def mostrar_versiculos(self):
        return self.fila.mostrar()


class Filadupla:
    def __init__(self):
        self.fila1 = Fila()
        self.fila2 = Fila()

    def adicionar_versiculo(self, versiculo):
        self.fila1.enfileirar(versiculo)

    def remover_versiculo(self):
        if not self.fila1.esta_vazia():
            return self.fila1.desenfileirar()
        if not self.fila2.esta_vazia():
            return self.fila2.desenfileirar()
        return None

    def mostrar_versiculos(self):
        return self.fila1.mostrar() + self.fila2.mostrar()


if __name__ == "__main__":
    biblia = biblia()
    biblia.adicionar_versiculo("João 3:16")
    biblia.adicionar_versiculo("Salmos 23:1")
    biblia.adicionar_versiculo("Filipenses 4:13")

    print("Versículos na Bíblia:")
    print(biblia.mostrar_versiculos())

    versiculo_removido = biblia.remover_versiculo()
    print(f"Versículo removido: {versiculo_removido}")

    print("Versículos restantes na Bíblia:")
    print(biblia.mostrar_versiculos())

    filadupla = Filadupla()
    filadupla.adicionar_versiculo("Gênesis 1:1")
    filadupla.adicionar_versiculo("Êxodo 20:12")
    filadupla.adicionar_versiculo("Mateus 5:9")

    print("Versículos na Fila Dupla:")
    print(filadupla.mostrar_versiculos())

    versiculo_removido = filadupla.remover_versiculo()
    print(f"Versículo removido: {versiculo_removido}")

    print("Versículos restantes na Fila Dupla:")
    print(filadupla.mostrar_versiculos())